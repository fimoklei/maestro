{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"; [ -f \"$h\" ] && exec node \"$h\" || exit 0",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
