.DS_Store
node_modules/
dist/
coverage/
storybook-static/
*.tsbuildinfo
*.log

# Dev launcher runtime + isolated smoke-run data (scripts/dev.mjs)
.maestro-dev.pid
.maestro-sandbox/

# graphify generated knowledge graph (rebuildable via `graphify .`)
graphify-out/

# Per-branch git worktrees created by agent sessions (local checkouts, not source).
.claude/worktrees/

# Local knowledge-graph output from the understand-anything skill (not source).
.understand-anything/

# Supacode session artifacts (local tool state, not source).
.sc/

# Codex CLI hook config written per machine (local tool state, not source).
.codex/

# Impeccable local runtime state (session journals, per-session hook cache).
# The design sidecar and live config are tracked. Match at any depth so a
# per-package .impeccable/ (e.g. packages/web/) ignores its cache too.
**/.impeccable/live/sessions/
**/.impeccable/hook.cache.json

# Per-machine local skill installs and symlinks (not project source). Project
# skills in these directories are tracked explicitly; only these local copies
# are ignored.
.agents/skills/impeccable/
.claude/skills/impeccable/
.claude/skills/agent-browser
.claude/skills/codex-review
