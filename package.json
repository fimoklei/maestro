{
  "name": "maestro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/dev.mjs --smoke",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.5.0",
    "@biomejs/biome": "^2.4.16",
    "@maestro/core": "workspace:*",
    "@maestro/server": "workspace:*",
    "@types/node": "^24.9.1",
    "concurrently": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
