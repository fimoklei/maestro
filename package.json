{
  "name": "maestro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/dev.mjs --smoke",
    "smoke:ready": "node scripts/smoke-ready.mjs",
    "build": "pnpm -r build",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs --project core",
    "test:web": "node scripts/run-tests.mjs --project web",
    "test:integration": "node scripts/run-tests.mjs --project integration",
    "test:acceptance": "node scripts/run-tests.mjs --project acceptance",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.5.0",
    "@biomejs/biome": "^2.4.16",
    "@maestro/core": "workspace:*",
    "@maestro/server": "workspace:*",
    "@types/node": "^24.9.1",
    "concurrently": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
