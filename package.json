{
  "name": "maestro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/dev.mjs --smoke",
    "smoke:ready": "node scripts/smoke-ready.mjs",
    "smoke:check": "node scripts/smoke-ready.mjs --check",
    "cockpit:url": "node scripts/cockpit-ports.mjs",
    "build": "pnpm -r build",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs --project core",
    "test:web": "node scripts/run-tests.mjs --project web",
    "test:integration": "node scripts/run-tests.mjs --project integration",
    "test:git": "node scripts/run-tests.mjs --project git",
    "test:loop": "node scripts/run-tests.mjs --project core --project web --project integration",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:watch": "vitest --project core --project web --project integration",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@maestro/core": "workspace:*",
    "@maestro/server": "workspace:*",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "^6.29.0",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3",
    "vitest": "^4.1.7"
  }
}
